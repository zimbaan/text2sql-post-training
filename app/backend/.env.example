# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=*

# LLM Provider
# Options: ollama | openrouter | openai
LLM_PROVIDER=ollama

# Ollama Configuration
DEFAULT_OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (hosted, OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security Settings
EXECUTION_SAFE_MODE=true
QUERY_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
JWT_SECRET_KEY=changeme-supersecret
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Connection Cache Settings
CONNECTION_EXPIRY_MINUTES=60

# Post-trained text-to-SQL model (runs inside the backend; needs: pip install -e ".[finetuned]")
FINETUNED_ENABLED=true
FINETUNED_MODEL_NAME=text2sql-qwen-0.5b-dpo
FINETUNED_BASE_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct
# Defaults to <repo>/models/text2sql-qwen-dpo
# FINETUNED_ADAPTER_PATH=
